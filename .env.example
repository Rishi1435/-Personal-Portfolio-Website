# Web3Forms API Key for portfolio contact form submission
# Get a free key at: https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=YOUR_ACCESS_KEY_HERE

# ── AI voice concierge (/api/ask) — server-side only, never exposed to client ──
# NVIDIA NIM API key (https://build.nvidia.com). Required for the concierge.
# Set this in the Vercel project env for production; .env is only for local `vercel dev`.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE

# Optional: override the model. Defaults to openai/gpt-oss-20b (fast, ~1-9s).
# nvidia/nemotron-3.5-lightning-30b-a3b also works but is very slow on the trial tier.
# ASK_MODEL=openai/gpt-oss-20b

# Optional: override the upstream timeout in ms (default 55000).
# ASK_TIMEOUT_MS=55000

# Optional: Upstash Redis REST for cross-instance rate limiting (falls back to
# in-memory per-instance if unset). https://upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
